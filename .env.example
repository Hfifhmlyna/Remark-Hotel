PORT=3000
NODE_ENV=development
SESSION_SECRET=please_change_this_to_a_long_random_secret
HOTEL_NAME=Remark Hotel

DB_PROVIDER=sqlite
DB_PATH=./database/app.db
# Untuk PostgreSQL cloud (production), set:
# DB_PROVIDER=postgres
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# Jika perlu non-SSL lokal: PGSSLMODE=disable

# Opsi SQLite di Vercel (demo cepat, data tidak persisten):
# DB_PATH=/tmp/app.db
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
LOGIN_LOCKOUT_MAX_FAILED=5
LOGIN_LOCKOUT_DURATION_MS=900000

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin123!
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME=Administrator

SEED_USER_USERNAME=user
SEED_USER_PASSWORD=User12345!
SEED_USER_EMAIL=user@example.com
SEED_USER_NAME=Pengguna Awal
