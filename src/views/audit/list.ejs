<%- include('../partials/header', { title }) %>

<section class="card admin-banner">
  <div class="row-between">
    <h1>Audit Logs</h1>
    <p class="meta">Pantau jejak aktivitas keamanan dan operasional sistem.</p>
  </div>
</section>

<section class="card">
  <div class="row-between">
    <h2>Daftar Log</h2>
    <p class="meta">Total log: <strong><%= pagination.totalItems %></strong></p>
  </div>

  <form method="get" action="/admin/audit-logs" class="form-grid compact-grid">
    <label for="action">Filter Action</label>
    <input id="action" name="action" type="text" value="<%= filters.action %>" placeholder="Contoh: LOGIN" />

    <label for="entityType">Filter Entity Type</label>
    <input
      id="entityType"
      name="entityType"
      type="text"
      value="<%= filters.entityType %>"
      placeholder="Contoh: reservation"
    />

    <label for="actor">Filter Actor (Username/Nama)</label>
    <input id="actor" name="actor" type="text" value="<%= filters.actor %>" placeholder="Contoh: admin" />

    <div class="actions">
      <button type="submit" class="btn">Terapkan Filter</button>
      <a class="btn-secondary" href="/admin/audit-logs">Reset</a>
    </div>
  </form>

  <% if (!logs.length) { %>
    <p>Belum ada data audit log untuk filter saat ini.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Waktu</th>
          <th>Actor</th>
          <th>Action</th>
          <th>Entity</th>
          <th>Entity ID</th>
          <th>IP</th>
          <th>Metadata</th>
        </tr>
      </thead>
      <tbody>
        <% logs.forEach((log) => { %>
          <tr>
            <td><%= log.created_at %></td>
            <td>
              <%= log.actor_username || '-' %>
              <% if (log.actor_name) { %>
                <br />
                <span class="meta"><%= log.actor_name %> (<%= log.actor_role || '-' %>)</span>
              <% } %>
            </td>
            <td><%= log.action %></td>
            <td><%= log.entity_type %></td>
            <td><%= log.entity_id || '-' %></td>
            <td><%= log.ip_address || '-' %></td>
            <td>
              <pre class="metadata-pre"><%= log.metadata_pretty %></pre>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="pagination">
      <% if (pagination.hasPrev) { %>
        <a
          class="btn-secondary"
          href="/admin/audit-logs?page=<%= pagination.page - 1 %>&action=<%= encodeURIComponent(filters.action) %>&entityType=<%= encodeURIComponent(filters.entityType) %>&actor=<%= encodeURIComponent(filters.actor) %>"
        >
          Prev
        </a>
      <% } %>

      <span class="meta">Halaman <strong><%= pagination.page %></strong> dari <strong><%= pagination.totalPages %></strong></span>

      <% if (pagination.hasNext) { %>
        <a
          class="btn-secondary"
          href="/admin/audit-logs?page=<%= pagination.page + 1 %>&action=<%= encodeURIComponent(filters.action) %>&entityType=<%= encodeURIComponent(filters.entityType) %>&actor=<%= encodeURIComponent(filters.actor) %>"
        >
          Next
        </a>
      <% } %>
    </div>
  <% } %>
</section>

<%- include('../partials/footer') %>
